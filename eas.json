{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "preview-ads": {
      "extends": "preview",
      "channel": "preview-ads",
      "env": {
        "EXPO_PUBLIC_CAMPAIGN_TEST_ADS": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
